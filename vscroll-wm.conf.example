# Konfigurasi vscroll-wm. Salin jadi "vscroll-wm.conf" di samping vscroll-wm.exe
# (atau di folder tempat app dijalankan, atau tunjuk dengan env VSCROLL_CONFIG).
# Komentar hanya berlaku untuk baris yang diawali #.
# Terapkan perubahan lewat tray -> "Muat ulang konfigurasi".

# Jarak antar window dan ke tepi layar, dalam piksel fisik (0-200).
gap = 16

# Durasi animasi dalam milidetik. 0 = mati. Hapus / beri # untuk memakai bawaan
# (160 ms, otomatis mati kalau "Animation effects" Windows dimatikan).
# anim_ms = 160

# Warna border window yang fokus (Windows 11), format #RRGGBB. off = tidak diubah.
# focus_border = #4FA8F5

# --- Lebar lajur ---
# Win+] menggeser pembagi ke kanan, Win+[ ke kiri, Win+\ mengembalikannya ke 50/50.
# Lebar dimiliki lajur (kiri / kanan), jadi semua window di lajur itu ikut berubah, dan
# pembagi disimpan per blok: window penuh lebar memisahkan blok di atas dan di bawahnya.
# Langkah tiap tekan dalam piksel (10-400). Menahan tombol mengulang terus.
resize_step = 80
# Win+Atas/Bawah: preset = lompat 1/3, 1/2, penuh (bawaan);
# step = geser per langkah (piksel, di bawah). Dekat 1/3, 1/2, atau penuh
# tinggi otomatis "menempel" ke ukuran itu.
height_mode = preset
height_step = 80

# --- Cheatsheet: daftar pintasan keyboard ---
# Tombol pembuka bersama Win: slash (bawaan, tombol /), f1-f12, tab, space, grave,
# satu huruf/angka, atau off. Tidak boleh sama dengan overview_key. Bisa juga dibuka
# dari menu tray ("Pintasan keyboard"). Tutup dengan tombol apa saja atau klik.
cheatsheet_key = slash

# --- Overview: panel peta strip, seperti Alt+Tab ---

# Tombol pembuka bersama Win: tab (bawaan), space, grave, satu huruf/angka, atau off.
# Tidak boleh q atau m (sudah dipakai: tutup / minimize). Win+Alt+Space selalu aktif.
# Catatan: tab menggantikan Task View (Win+Tab); virtual desktop tetap lewat Win+Ctrl+Panah.
#
# Cara pakai gaya Alt+Tab: tahan Win, tekan tombol ini untuk membuka, lalu tekan lagi
# untuk pindah ke window berikutnya (Shift = sebelumnya), atau pakai panah. Lepas Win
# untuk loncat ke window yang dipilih. Kalau Win dilepas tanpa menggeser pilihan, panel
# tetap terbuka (Enter memilih, Esc membatalkan). Selama panel terbuka, tiling dimatikan.
overview_key = tab

# Ukuran maksimum panel, persen dari area kerja (30-100).
overview_size = 70

# Petunjuk tombol di bagian bawah panel: on / off.
overview_hint = on

# Tampilan mini tiap window: on / off. Matikan kalau ada window yang tampil kosong.
overview_thumbnails = on

# Isi label kotak:
#   title   = judul window apa adanya
#   app     = nama app saja (dari nama exe), mis. "Vivaldi"
#   reverse = bagian terakhir setelah " - " dipindah ke depan,
#             mis. "Chat baru - Vivaldi" jadi "Vivaldi - Chat baru"
overview_label = title

# Nama tampilan untuk mode `app`: alias.<nama exe tanpa .exe> = Nama.
# Beberapa nama umum sudah bawaan (Code -> VS Code, msedge -> Edge, dst).
# alias.wezterm-gui = WezTerm

# Warna overview, format #RRGGBB (nilai di bawah adalah bawaan):
#   selected   = kursor: window yang akan dituju
#   active     = window yang sedang aktif sekarang
#   view       = bingkai bagian (baris) strip yang sedang tampil di layar
#   background = latar panel
#   box        = isi kotak window
# overview_color_selected = #FFBE3C
# overview_color_active = #4FA8F5
# overview_color_view = #78C882
# overview_color_background = #14161C
# overview_color_box = #2D3240

# --- Remember layout ---
# on (default): the workspace layout (order, widths, heights, divider positions,
# which window is on which workspace, the focused window) is saved automatically to
# %LOCALAPPDATA%\vscroll-wm\layout.state. If vscroll-wm is started again while those
# windows are still open (restart, crash), the layout comes back. Windows are matched by
# handle plus exe/class name, so after a reboot nothing is restored (apps get new
# handles). off: never save or restore.
remember_layout = on

# --- Workspace indicator ---
# on (default): a small panel appears near the bottom of the screen for about a second
# whenever the workspace changes ("Workspace 2" plus one box per workspace, the current
# one highlighted). It never takes focus and ignores clicks. Colors follow the overview
# colors below. off: no panel.
workspace_osd = on

# --- Overview: wrap-around arrow navigation ---
# on (default): arrow keys in the overview wrap around. Up on the top row goes to the
# bottom row and vice versa; Left / Right at a workspace edge continue into the
# neighbouring workspace, and from the last / first workspace wrap to the first / last
# (with a single workspace they wrap inside it). off: stop at the ends.
overview_wrap = on

# --- Custom shortcuts (bind.<action>) ---
# Every shortcut can be changed here; the cheatsheet (Win+/) always shows what is
# actually in effect. Format:  bind.<action> = <chord>[, <chord>...]
#   chord      modifiers joined with "+", then the key, e.g.  win+shift+left
#   modifiers  win, ctrl, alt, shift  (at least one is required)
#   keys       a-z, 0-9, left right up down, enter, esc, space, tab, backspace, delete,
#              insert, home, end, pageup, pagedown, f1-f12, slash, backslash, lbracket,
#              rbracket, grave, comma, period, minus, equals, semicolon, quote
#   off        disables the action;  several chords are separated by commas
# Numbered actions (workspace_goto, workspace_send) take "1-9" as the key.
# Win+Ctrl+Esc (quit) and Win+Ctrl+D / F4 (blocked) are reserved and cannot be changed.
# If a chord is claimed twice, the line that is written in this file wins over a default,
# and the earlier line wins over a later one; a warning is printed to the console.
# overview_key / cheatsheet_key above still work as the default chord of the overview /
# cheatsheet actions, unless bind.overview / bind.cheatsheet is set.
#
# Actions and their defaults:
#   snap_up = win+up                    shorter (taller with snap_down)
#   snap_down = win+down
#   snap_left = win+left                move into the left column
#   snap_right = win+right
#   split_right = win+]                 move the column divider
#   split_left = win+[
#   split_reset = win+\                 divider back to 50/50
#   maximize = win+enter                full width and height
#   focus_left / focus_right / focus_up / focus_down = win+shift+<arrow>
#   swap_left / swap_right / swap_up / swap_down = win+alt+<arrow>
#   overview = win+tab, win+alt+space
#   workspace_prev = win+ctrl+left      workspace_next = win+ctrl+right
#   workspace_goto = win+ctrl+1-9       workspace_send = win+ctrl+shift+1-9
#   workspace_send_prev = win+ctrl+shift+left   workspace_send_next = win+ctrl+shift+right
#   close = win+q       minimize = win+m       float = win+alt+f       inspect = win+alt+i
#   cheatsheet = win+/
#
# Examples:
# bind.close = win+w
# bind.minimize = off
# bind.focus_left = alt+h
# bind.focus_right = alt+l
# bind.overview = win+o, win+alt+space
